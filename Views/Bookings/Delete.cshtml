@model EventEase.Web.Models.Booking

<h2>Delete Booking</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this booking?
</div>

<form asp-action="Delete">

    <input type="hidden"
           asp-for="BookingId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
           class="btn btn-secondary">
        Cancel
    </a>

</form>