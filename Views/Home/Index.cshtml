@{
    ViewData["Title"] = "Dashboard";
}

<h2>Dashboard</h2>

<div class="row">

    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <h2>@ViewBag.TotalVenues</h2>
                <p>Total Venues</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <h2>@ViewBag.TotalEvents</h2>
                <p>Total Events</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body text-center">
                <h2>@ViewBag.TotalBookings</h2>
                <p>Total Bookings</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-danger text-white">
            <div class="card-body text-center">
                <h2>@ViewBag.TotalEventTypes</h2>
                <p>Event Types</p>
            </div>
        </div>
    </div>

</div>

<hr />

<div class="row">

    <div class="col-md-6">

        <h4>Upcoming Events</h4>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Type</th>
                    <th>Date</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in ViewBag.UpcomingEvents)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.EventType?.Name</td>
                        <td>@item.StartDate.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

    <div class="col-md-6">

        <h4>Recent Bookings</h4>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>Event</th>
                    <th>Venue</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in ViewBag.RecentBookings)
                {
                    <tr>
                        <td>@item.BookingId</td>
                        <td>@item.Event?.Name</td>
                        <td>@item.Venue?.Name</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>