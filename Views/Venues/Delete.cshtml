@model EventEase.Web.Models.Venue

<h2>Delete Venue</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this venue?
</div>

<div class="card p-4">

    <h4>@Model.Name</h4>

    <p>@Model.Location</p>

    <form asp-action="DeleteConfirmed"
          method="post">

        <input type="hidden"
               asp-for="VenueId" />

        <button class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
               class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>